# Contoh konfigurasi environment — copy ke .env
# Untuk lokal (podman/docker):
DATABASE_URL="postgresql://wa:wa_dev_password@localhost:5432/monitoring_whatsapp"
# Untuk Supabase (contoh):
# DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_REF.supabase.co:5432/postgres"

# Shadow DB untuk `prisma migrate diff` (opsional, dev saja):
# SHADOW_DATABASE_URL="postgresql://wa:wa_dev_password@localhost:5432/monitoring_whatsapp_shadow"

# WhatsApp Cloud API (Meta). Jangan commit nilai aslinya.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Master key enkripsi credential WhatsApp di DB (AES-256). Generate: openssl rand -hex 32
# WAJIB disimpan aman, tidak ke repo/frontend/log. Ganti dengan nilai baru untuk produksi.
WHATSAPP_CONFIG_ENCRYPTION_KEY=


# Session auth (sealed cookie). Generate: openssl rand -hex 32. Wajib kuat & rahasia di produksi.
AUTH_SECRET=

# Data retention (hari). 0 = disabled (tidak menghapus apa pun).
DATA_RETENTION_DAYS=0

# Meta E2E real-send safety (default MATI). Real send hanya bila true + recipient diisi.
META_E2E_ENABLE_SEND=false
META_E2E_TEST_RECIPIENT=
